{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MilyVoiceTraductor",
  "mainBinaryName": "MilyVoiceTraductor",
  "version": "1.0.0-rc.1",
  "identifier": "com.milyvoice.traductor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MilyVoiceTraductor",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "shortDescription": "Traductor local de reuniones inglés/chino a español",
    "longDescription": "MilyVoiceTraductor procesa audio y traducción de forma local con motor y modelos administrados por el usuario.",
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
