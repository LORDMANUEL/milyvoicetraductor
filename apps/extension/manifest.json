{
  "manifest_version": 3,
  "name": "MilyVoiceTraductor",
  "version": "1.0.0",
  "description": "Subtítulos locales inglés/chino a español con MilyVoiceTraductor.",
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "MilyVoiceTraductor",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://*.teams.microsoft.com/*",
        "https://zoom.us/*",
        "https://*.zoom.us/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "version_name": "1.0.0-rc.1"
}
