{
  "manifest_version": 3,
  "name": "MilyVoiceTraductor",
  "version": "2.0.0",
  "version_name": "2.0.0",
  "description": "Traducción local en tiempo real para español, inglés y chino con MilyVoiceTraductor 2.0.",
  "key": "",
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen",
    "storage",
    "notifications",
    "nativeMessaging",
    "scripting",
    "tts"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "MilyVoiceTraductor",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
