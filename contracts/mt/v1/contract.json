{
  "id": "mt/v1",
  "owner": "mt",
  "status": "candidate",
  "encoding": "json",
  "compatibility": "additive-within-major",
  "messages": {
    "MtRequestDescriptor": {
      "required": ["requestId", "utteranceId", "route", "sourceLanguage", "targetLanguage", "text"],
      "fields": {
        "requestId": {"type": "string"},
        "utteranceId": {"type": "string"},
        "route": {"type": "string"},
        "sourceLanguage": {"type": "string"},
        "targetLanguage": {"type": "string"},
        "text": {"type": "string"}
      }
    },
    "MissingNumber": {
      "required": ["value"],
      "fields": {
        "value": {"type": "string"}
      }
    },
    "MtQualityReport": {
      "required": ["tokenCount", "ngramSize", "repeatedNgramRatio", "maxNgramOccurrences", "repeatedSentenceCount", "passed", "reason"],
      "fields": {
        "tokenCount": {"type": "integer"},
        "ngramSize": {"type": "integer"},
        "repeatedNgramRatio": {"type": "number"},
        "maxNgramOccurrences": {"type": "integer"},
        "repeatedSentenceCount": {"type": "integer"},
        "passed": {"type": "boolean"},
        "reason": {"type": "enum:QualityReason"}
      }
    },
    "MtFidelityReport": {
      "required": ["missingNumbers", "sourceHasNegation", "targetHasNegation", "passed", "reason"],
      "fields": {
        "missingNumbers": {"type": "array:MissingNumber"},
        "sourceHasNegation": {"type": "boolean"},
        "targetHasNegation": {"type": "boolean"},
        "passed": {"type": "boolean"},
        "reason": {"type": "enum:FidelityReason"}
      }
    },
    "MtResult": {
      "required": ["requestId", "utteranceId", "engineId", "providerId", "sourceLanguage", "targetLanguage", "sourceText", "targetText", "accepted", "reason", "quality", "fidelity", "elapsedMs"],
      "fields": {
        "requestId": {"type": "string"},
        "utteranceId": {"type": "string"},
        "engineId": {"type": "string"},
        "providerId": {"type": "string"},
        "sourceLanguage": {"type": "string"},
        "targetLanguage": {"type": "string"},
        "sourceText": {"type": "string"},
        "targetText": {"type": "string"},
        "accepted": {"type": "boolean"},
        "reason": {"type": "enum:DecisionReason"},
        "quality": {"type": "object:MtQualityReport"},
        "fidelity": {"type": "object:MtFidelityReport"},
        "elapsedMs": {"type": "number"}
      }
    }
  },
  "enums": {
    "QualityReason": ["OK", "EMPTY", "REPEATED_SENTENCE", "REPEATED_NGRAM", "REPETITION_RATIO"],
    "FidelityReason": ["OK", "NUMBER_LOST", "NEGATION_LOST"],
    "DecisionReason": ["OK", "EMPTY", "REPEATED_SENTENCE", "REPEATED_NGRAM", "REPETITION_RATIO", "NUMBER_LOST", "NEGATION_LOST"]
  },
  "examples": {
    "request": {
      "message": "MtRequestDescriptor",
      "path": "examples/request.json"
    },
    "result": {
      "message": "MtResult",
      "path": "examples/result.json"
    }
  },
  "invariants": [
    "mt/v1 consumes text already prepared by linguistic/v1 and never owns conversation persistence",
    "request route must agree with the adapter route before provider invocation",
    "candidate 1.0.0 promotes only en-es and zh-es because those are the only current local model-pack routes backed by certified repository metadata",
    "target text is never silently replaced by source text when quality or fidelity checks fail",
    "accepted is true only when both deterministic quality and fidelity reports pass",
    "engine and provider identifiers remain strings so future local MT families can be added additively",
    "model paths, provider prompts and model internals never cross mt/v1"
  ]
}
